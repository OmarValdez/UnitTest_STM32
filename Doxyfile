# Doxyfile para documentación del proyecto SW (IEC 62304)
# Los requisitos se documentan en el código con el tag @req, que se mapea a
# una sección dedicada de trazabilidad ("Requisitos") mediante \xrefitem.

PROJECT_NAME           = "ST_UnitTest (Piloto IEC 62304)"
PROJECT_NUMBER         = 0.1
PROJECT_BRIEF          = "Firmware piloto con trazabilidad de requisitos"

OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
QUIET                  = YES

# Alias: @requirement (y también @req por compatibilidad) -> sección "Requisitos"
ALIASES                = "req=\xrefitem requirement \"Requisito\" \"Requisitos\"" \
                         "requirement=\xrefitem requirement \"Requisito\" \"Requisitos\""

# Extracción
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO

# Advertencias (útil para IEC 62304: el código debe estar documentado)
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = docs/doxygen_warnings.log

INPUT                  = Core/Src Core/Inc Core/User/Src Core/User/Inc \
                          tests/test requirements
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.h *.md

# Excluir código generado por CubeMX / vendor (no es del equipo)
EXCLUDE                = Core/Src/sysmem.c \
                         Core/Src/syscalls.c \
                         Core/Src/stm32f1xx_hal_msp.c \
                         Core/Src/system_stm32f1xx.c \
                         Core/Inc/stm32f1xx_hal_conf.h

# Generadores
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

# Navegacion sin JavaScript (treeview/search) para que el reporte publicado
# en Jenkins (iframe + Content-Security-Policy estricto) sea navegable con
# links HTML planos en lugar de depender de JS bloqueado por el CSP.
DISABLE_INDEX          = YES
GENERATE_TREEVIEW      = NO
SEARCHENGINE           = NO
SERVER_BASED_SEARCH    = NO

HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
SOURCE_BROWSER         = YES
