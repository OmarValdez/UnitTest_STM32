# ============================================================
# SCRIPT PARA STM32F103CBT6 - OPTIMIZADO PARA CI/CD
# ============================================================

using sysbus

# 1. CREAR MÁQUINA
mach create "stm32f103"

# 2. CARGAR PLATAFORMA
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl

# 3. DEFINIR LED Y BOTÓN (usando los nombres que funcionaron)
machine LoadPlatformDescriptionFromString "led: Miscellaneous.LED @ gpioPortC 13"
machine LoadPlatformDescriptionFromString "boton: Miscellaneous.Button @ gpioPortB 12 { IRQ -> gpioPortB@12 }"

# 4. CARGAR FIRMWARE
$bin?=@../build/Debug/ST_UnitTest.elf
sysbus LoadELF $bin
echo "✅ Firmware cargado correctamente"

# 5. LOGS PARA DEPURACIÓN
logLevel -1 gpioPortC.led
logLevel -1 gpioPortB.boton

# Logs adicionales para ver actividad
sysbus LogAllPeripheralsAccess true

# 6. SIMULACIÓN CON PRUEBAS
echo "======================================================"
echo "🟢 SIMULACIÓN INICIADA"
echo "   LED en PC13"
echo "   Botón en PB12 (con interrupción)"
echo "======================================================"

start

# Esperar a que el firmware se estabilice
sleep 1

echo ""
echo "🟢 Realizando pruebas..."

# Secuencia de pruebas
echo "🟢 Presionando botón 1..."
gpioPortB.boton PressAndRelease
sleep 0.5

echo "🟢 Presionando botón 2..."
gpioPortB.boton PressAndRelease
sleep 0.5

echo "🟢 Presionando botón 3..."
gpioPortB.boton PressAndRelease
sleep 0.5

# Verificar estado final del LED
echo ""
echo "🟢 Estado final del LED:"
gpioPortC.led State

echo ""
echo "======================================================"
echo "🟢 SIMULACIÓN FINALIZADA"
echo "======================================================"

quit