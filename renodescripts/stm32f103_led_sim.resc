# ============================================================
# SCRIPT DEFINITIVO PARA STM32F103CBT6
# USANDO EXECUTE COMMAND (API DE RENODE)
# ============================================================

using sysbus

# 1. CREAR MÁQUINA
Execute Command mach create "stm32f103"

# 2. CARGAR PLATAFORMA
Execute Command machine LoadPlatformDescription @platforms/cpus/stm32f103.repl

# 3. DEFINIR LED Y BOTÓN
Execute Command "machine LoadPlatformDescriptionFromString \"led: Miscellaneous.LED @ gpioPortC 13\""
Execute Command "machine LoadPlatformDescriptionFromString \"button: Miscellaneous.Button @ gpioPortB 12\""

# 4. CARGAR FIRMWARE
$bin?=@../build/Debug/ST_UnitTest.elf
sysbus LoadELF $bin
echo "✅ Firmware cargado correctamente"

# 5. LOGS
Execute Command "logLevel -1 led"
Execute Command "logLevel -1 button"

# 6. SIMULACIÓN
echo "======================================================"
echo "🟢 SIMULACIÓN INICIADA"
echo "   LED en PC13"
echo "   Botón en PB12 (con interrupción)"
echo "======================================================"

Execute Command start

echo ""
echo "🟢 Esperando 2 segundos..."
sleep 2

echo "🟢 Presionando botón..."
Execute Command "button Press"
echo "   ✅ Botón presionado"
sleep 1

echo "🟢 Liberando botón..."
Execute Command "button Release"
echo "   ✅ Botón liberado"
sleep 1

echo "🟢 Presionando botón nuevamente..."
Execute Command "button Press"
sleep 1
Execute Command "button Release"

echo ""
echo "🟢 Esperando 3 segundos..."
sleep 3

echo "======================================================"
echo "🟢 SIMULACIÓN FINALIZADA"
echo "======================================================"

Execute Command quit