# ============================================================
# STM32F103CBT6 - BluePill
# System integration test (Renode)
#
# Verifica la logica boton -> LED de forma equivalente a
# tests/test/test_led_logic.c, pero sobre el micro real modelado:
#   - Boton en PB12, activo-bajo (presionar = pin a GND = 0),
#     emulado con Miscellaneous.Button { IRQ -> gpioPortB@12; invert: true }
#   - LED en PC13, activo-bajo (encender = pin a GND = 0).
#   - La conmutacion se verifica leyendo el ODR de GPIOC:
#       LED OFF -> PC13=1 (ODR 0x2000)
#       LED ON  -> PC13=0 (ODR 0x0000)
# ============================================================

using sysbus

mach create "stm32f103"
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl

# LED (salida, activo-bajo en BluePill) y boton (entrada, activo-bajo).
machine LoadPlatformDescriptionFromString "led: Miscellaneous.LED @ gpioPortC 13"
machine LoadPlatformDescriptionFromString "boton: Miscellaneous.Button @ gpioPortB 12 { IRQ -> gpioPortB@12; invert: true }"

$bin?=@../build/DockerDebug/ST_UnitTest.elf
sysbus LoadELF $bin
echo "Firmware cargado"

# Detectar caida en Error_Handler (fallo de arranque/inicializacion).
cpu AddHook `sysbus GetSymbolAddress "Error_Handler"` "cpu.ErrorLog('ERROR: Error_Handler alcanzado en @ {0}', monitor.Machine.ElapsedVirtualTime.TimeElapsed)"

macro press
"""
    gpioPortB.boton Press
    sleep 0.3
    gpioPortB.boton Release
    sleep 0.1
"""

start
sleep 1

# led_logic_init() deja el LED apagado -> PC13=1 -> ODR 0x2000
echo "ODR PC13 inicial (esperado 0x2000 = LED OFF):"
sysbus ReadDoubleWord 0x4001100C

echo "Presion boton 1 (esperado LED ON -> ODR 0x0000):"
runMacro $press
sysbus ReadDoubleWord 0x4001100C

echo "Presion boton 2 (esperado LED OFF -> ODR 0x2000):"
runMacro $press
sysbus ReadDoubleWord 0x4001100C

echo "Presion boton 3 (esperado LED ON -> ODR 0x0000):"
runMacro $press
sysbus ReadDoubleWord 0x4001100C

echo "SIMULACION FINALIZADA"
quit
