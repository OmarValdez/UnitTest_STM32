# Script para simular STM32F103CBT6 con LED

using sysbus

# Crear la máquina
mach create "stm32f103"

# Cargar la plataforma STM32F103
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl

# Configurar LED en puerto C, pin 13 (típico en STM32F103 "Blue Pill")
gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x40011000, +0x400>
    [0-15] -> exti@[0-15]

UserLED: Miscellaneous.LED @ gpioPortC
    gpioPortC: 13 -> UserLED@0

# Cargar el firmware compilado
# Ajusta la ruta según donde se genere tu .elf
sysbus LoadELF @../build/Debug/ST_UnitTest.elf

# Mostrar logs del LED
logLevel -1 gpioPortC.UserLED

# Ejecutar la simulación
start

# Esperar 10 segundos para ver el comportamiento
sleep 10

# Salir
quit