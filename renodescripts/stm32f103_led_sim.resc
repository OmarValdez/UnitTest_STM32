# Script para simular STM32F103CBT6 con LED en PC13 y botón en PB12
# Sintaxis compatible con Renode 1.16.1

using sysbus

# Crear la máquina
mach create "stm32f103"

# Cargar la plataforma STM32F103
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl

# ============================================================
# CONFIGURACIÓN DE LED (PC13)
# ============================================================
# Crear el puerto C
gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus 0x40011000

# Crear un LED como un dispositivo simple
led: Miscellaneous.LED

# Conectar el pin 13 del puerto C al LED
gpioPortC.Connect(13, led)

# ============================================================
# CONFIGURACIÓN DE BOTÓN (PB12)
# ============================================================
# Crear el puerto B
gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus 0x40010C00

# Crear un botón
button: Miscellaneous.Button

# Conectar el pin 12 del puerto B al botón
gpioPortB.Connect(12, button)

# ============================================================
# CARGAR FIRMWARE
# ============================================================
# Cargar el firmware compilado
if File.Exists(@../build/Debug/ST_UnitTest.elf) then
    sysbus LoadELF @../build/Debug/ST_UnitTest.elf
    echo "✅ Firmware cargado correctamente"
else
    echo "⚠️  Firmware no encontrado: ../build/Debug/ST_UnitTest.elf"
end

# ============================================================
# LOGS
# ============================================================
# Mostrar logs del LED
logLevel -1 led

# ============================================================
# SIMULACIÓN Y PRUEBAS
# ============================================================
# Iniciar la simulación
start

# Esperar 2 segundos
sleep 2

# Simular una pulsación del botón
echo "🟢 Simulando pulsación del botón..."
button Press
sleep 1
button Release
echo "🟢 Botón liberado"

# Esperar más tiempo para ver el comportamiento
sleep 5

# Salir
quit