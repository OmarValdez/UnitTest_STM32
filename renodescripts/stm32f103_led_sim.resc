# ============================================================
# SCRIPT DEFINITIVO PARA STM32F103CBT6
# CREANDO DISPOSITIVOS EN SYSBUS
# ============================================================

using sysbus

# 1. CREAR MÁQUINA
mach create "stm32f103"

# 2. CARGAR PLATAFORMA
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl

# ============================================================
# 3. CREAR DISPOSITIVOS EN SYSBUS
# ============================================================
machine LoadPlatformDescriptionFromString "led: Miscellaneous.LED @ gpioPortC 13"
machine LoadPlatformDescriptionFromString "button: Miscellaneous.Button @ gpioPortB 12"

# ============================================================
# 4. CARGAR FIRMWARE
# ============================================================
$bin?=@../build/Debug/ST_UnitTest.elf
sysbus LoadELF $bin
echo "✅ Firmware cargado correctamente"

# ============================================================
# 5. LOGS
# ============================================================
logLevel -1 sysbus.led
logLevel -1 sysbus.button

# ============================================================
# 6. SIMULACIÓN
# ============================================================
echo "======================================================"
echo "🟢 SIMULACIÓN INICIADA"
echo "   LED en PC13"
echo "   Botón en PB12 (con interrupción)"
echo "======================================================"

start

echo ""
echo "🟢 Esperando 2 segundos..."
sleep 2

# Para el botón, simular pulsación
# Execute Command "button Press"

echo ""
echo "🟢 Esperando 3 segundos..."
sleep 3

echo "======================================================"
echo "🟢 SIMULACIÓN FINALIZADA"
echo "======================================================"

quit