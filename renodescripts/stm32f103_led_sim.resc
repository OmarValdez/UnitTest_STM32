# ============================================================
# SCRIPT COMPLETO PARA STM32F103CBT6
# LED en PC13, Botón en PB12 con interrupción
# ============================================================

using sysbus

# ============================================================
# 1. CREAR MÁQUINA Y CARGAR PLATAFORMA
# ============================================================
mach create "stm32f103"
machine LoadPlatformDescription "D:/Program Files/Renode/platforms/cpus/stm32f103.repl"

# ============================================================
# 2. CONFIGURAR LED (PC13)
# ============================================================
# El puerto C ya existe en la plataforma (dirección 0x40011000)
# Crear un LED y conectarlo al pin 13
led: Miscellaneous.LED
gpioPortC.Connect(13, led)

# ============================================================
# 3. CONFIGURAR BOTÓN (PB12) CON INTERRUPCIÓN
# ============================================================
# El puerto B ya existe en la plataforma (dirección 0x40010C00)
# Crear un botón y conectarlo al pin 12
button: Miscellaneous.Button
gpioPortB.Connect(12, button)

# ============================================================
# 4. CONFIGURAR INTERRUPCIÓN PARA EL BOTÓN
# ============================================================
# En STM32F103, EXTI (External Interrupt) maneja las interrupciones
# Conectar el pin 12 del puerto B al EXTI
gpioPortB.Connect(12, sysbus.exti.Line[12])

# ============================================================
# 5. CARGAR FIRMWARE
# ============================================================
if File.Exists("../build/Debug/ST_UnitTest.elf") then
    sysbus LoadELF "../build/Debug/ST_UnitTest.elf"
    echo "✅ Firmware cargado correctamente desde ../build/Debug/ST_UnitTest.elf"
else
    echo "⚠️  Firmware no encontrado: ../build/Debug/ST_UnitTest.elf"
    echo "⚠️  Continuando sin firmware..."
end

# ============================================================
# 6. LOGS PARA DEPURACIÓN
# ============================================================
# Logs del LED (cuando cambia de estado)
logLevel -1 led

# Logs del botón (cuando se presiona o libera)
logLevel -1 button

# Logs de la interrupción (opcional)
# logLevel -1 sysbus.exti

# ============================================================
# 7. SIMULACIÓN DE COMPORTAMIENTO
# ============================================================
echo "======================================================"
echo "🟢 SIMULACIÓN INICIADA"
echo "   LED en PC13"
echo "   Botón en PB12 (con interrupción)"
echo "======================================================"

# Iniciar la simulación
start

# ============================================================
# 8. SIMULAR PULSACIONES DEL BOTÓN
# ============================================================
echo ""
echo "🟢 Esperando 2 segundos..."
sleep 2

echo "🟢 Presionando botón (simula interrupción)..."
button Press
echo "   ✅ Botón presionado (flanco de subida)"
sleep 1

echo "🟢 Liberando botón..."
button Release
echo "   ✅ Botón liberado (flanco de bajada)"
sleep 1

echo "🟢 Presionando botón nuevamente..."
button Press
echo "   ✅ Botón presionado (flanco de subida)"
sleep 1

echo "🟢 Liberando botón..."
button Release
echo "   ✅ Botón liberado (flanco de bajada)"
sleep 1

echo "🟢 Presionando botón por última vez..."
button Press
sleep 1
button Release

# ============================================================
# 9. ESPERAR Y FINALIZAR
# ============================================================
echo ""
echo "🟢 Esperando 3 segundos para observar el estado final..."
sleep 3

echo ""
echo "======================================================"
echo "🟢 SIMULACIÓN FINALIZADA"
echo "======================================================"

quit