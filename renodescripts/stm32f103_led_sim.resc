# ============================================================
# SCRIPT BASADO EN EL EJEMPLO OFICIAL DE RENODE
# ============================================================

using sysbus

# 1. CREAR MÁQUINA
mach create "stm32f103"

# 2. CARGAR PLATAFORMA
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl

# 3. DEFINIR LED Y BOTÓN USANDO LoadPlatformDescriptionFromString
# Definir LED en PC13
machine LoadPlatformDescriptionFromString "led: Miscellaneous.LED @ gpioPortC 13"

# Definir botón en PB12 con interrupción
machine LoadPlatformDescriptionFromString "button: Miscellaneous.Button @ gpioPortB 12 { IRQ -> gpioPortB@12 }"

# 4. CARGAR FIRMWARE
if File.Exists("../build/Debug/ST_UnitTest.elf") then
    sysbus LoadELF "../build/Debug/ST_UnitTest.elf"
    echo "✅ Firmware cargado correctamente"
else
    echo "⚠️  Firmware no encontrado: ../build/Debug/ST_UnitTest.elf"
end

# 5. LOGS
logLevel -1 led
logLevel -1 button

# 6. SIMULACIÓN
echo "======================================================"
echo "🟢 SIMULACIÓN INICIADA"
echo "   LED en PC13"
echo "   Botón en PB12 (con interrupción)"
echo "======================================================"

start

echo ""
echo "🟢 Esperando 2 segundos..."
sleep 2

echo "🟢 Presionando botón..."
button Press
echo "   ✅ Botón presionado"
sleep 1

echo "🟢 Liberando botón..."
button Release
echo "   ✅ Botón liberado"
sleep 1

echo "🟢 Presionando botón nuevamente..."
button Press
sleep 1
button Release

echo ""
echo "🟢 Esperando 3 segundos..."
sleep 3

echo "======================================================"
echo "🟢 SIMULACIÓN FINALIZADA"
echo "======================================================"

quit