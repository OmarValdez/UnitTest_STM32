# Script para simular STM32F103CBT6 con LED en PC13 y botón en PB12

using sysbus

# Crear la máquina
mach create "stm32f103"

# Cargar la plataforma STM32F103
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl

# ============================================================
# CONFIGURACIÓN DE LED (PC13) - MÉTODO CORRECTO
# ============================================================
# Crear el puerto C
gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus 0x40011000

# Conectar el pin 13 del puerto C a un LED
# La sintaxis correcta es: gpioPortC.Pin[13] -> led@0
gpioPortC.Pin[13] -> led@0

# ============================================================
# CONFIGURACIÓN DE BOTÓN (PB12)
# ============================================================
# Crear el puerto B
gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus 0x40010C00

# Crear un botón en el pin 12 del puerto B
button@0: Miscellaneous.Button
gpioPortB.Pin[12] -> button@0

# ============================================================
# CARGAR FIRMWARE
# ============================================================
# Cargar el firmware compilado
if File.Exists(@../build/Debug/ST_UnitTest.elf) then
    sysbus LoadELF @../build/Debug/ST_UnitTest.elf
    echo "✅ Firmware cargado correctamente desde ../build/Debug/ST_UnitTest.elf"
else
    echo "⚠️  Firmware no encontrado: ../build/Debug/ST_UnitTest.elf"
end

# ============================================================
# LOGS
# ============================================================
# Mostrar logs del LED
logLevel -1 gpioPortC.Pin[13]

# ============================================================
# SIMULAR PULSACIONES DE BOTÓN (opcional)
# ============================================================
# Iniciar la simulación
start

# Esperar 2 segundos
sleep 2

# Simular una pulsación del botón
echo "🟢 Simulando pulsación del botón..."
button@0 Press
sleep 1
button@0 Release
echo "🟢 Botón liberado"

# Esperar 5 segundos más para ver el comportamiento
sleep 5

# Salir
quit